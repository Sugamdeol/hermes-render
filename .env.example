# Hermes Agent on Render: environment variables
#
# This Blueprint is designed for Render's Free instance type. Its filesystem
# is ephemeral: /opt/data/.env is lost when the service spins down or is
# redeployed. Put provider keys, tool keys, and chat platform tokens in the
# Render Environment tab so they survive those events. The Hermes dashboard
# API Keys tab is still useful for local Docker/paid-disk deployments, but
# values entered there are only temporary on Render Free.
#
# Full upstream env-var reference:
# https://github.com/NousResearch/hermes-agent/blob/main/.env.example

# =============================================================================
# Container boot config (set by the Blueprint, no user action needed)
# =============================================================================

# Hermes state directory. On Render Free this directory is ephemeral.
HERMES_HOME=/opt/data

# Render routes HTTP traffic to this port.
PORT=10000

# Enables the dashboard side-process inside the gateway container.
HERMES_DASHBOARD=1

# Bind the dashboard to all interfaces so Render's load balancer can reach it.
# The entrypoint passes --insecure automatically when this is non-loopback.
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000

# Enable the dashboard Chat tab by default. The bundled
# hermes-chat-dashboard plugin talks to Hermes' pure-Python /api/ws gateway;
# upstream still gates that route behind HERMES_DASHBOARD_TUI on the pinned
# Hermes release. The heavier Node/esbuild PTY path only starts if a client
# actually opens /api/pty, which the plugin never does.
HERMES_DASHBOARD_TUI=1
# The web chat does not use the interactive TUI slash menu, so keep its
# per-conversation helper process disabled on small instances.
HERMES_TUI_DISABLE_SLASH_WORKER=1
# Bound tui_gateway's long-RPC worker pool and release in-process sessions
# when a browser socket disconnects so abandoned chats do not accumulate RAM.
HERMES_TUI_RPC_POOL_WORKERS=2
HERMES_TUI_CLOSE_SESSIONS_ON_DISCONNECT=1
HERMES_TUI_MAX_SESSIONS=2

# Resource guardrails for small Render Free instances.
NODE_OPTIONS=--max-old-space-size=96
MALLOC_ARENA_MAX=2
MALLOC_TRIM_THRESHOLD_=131072
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
MAKEFLAGS=-j1
# The Dockerfile makes the pinned gateway cache these many idle session agents
# for this many seconds before eviction. The 512MB Render Free deploy uses a
# tighter 2 / 120 (see render.yaml) because it kept OOM-restarting at 8/600;
# keep 8/600 only if your instance has room for several concurrent sessions.
HERMES_AGENT_CACHE_MAX_SIZE=2
HERMES_AGENT_CACHE_IDLE_TTL_SECONDS=120

# Proactive OOM guard (memory_guard_loop in bootstrap.sh). On a container with
# a measurable cgroup cap <= HERMES_MEMGUARD_MAX_ACTIVE_MB it polls memory and
# reclaims BEFORE the kernel OOM-kills the container: telemetry at WARN%,
# SIGSTOP the git state-sync daemon at PAUSE_SYNC% (resume at RESUME_SYNC%),
# and as a last resort drop the dashboard at DASHBOARD_PCT%. Set to 0 to turn
# the whole guard off, or DASHBOARD_PCT=0 to never recycle the dashboard.
HERMES_MEMGUARD=1
HERMES_MEMGUARD_INTERVAL_SECONDS=3
HERMES_MEMGUARD_WARN=70
HERMES_MEMGUARD_PAUSE_SYNC=80
HERMES_MEMGUARD_RESUME_SYNC=62
HERMES_MEMGUARD_CRITICAL=87
HERMES_MEMGUARD_DASHBOARD_PCT=92
HERMES_MEMGUARD_MAX_ACTIVE_MB=2048
# Opt-in fallback only: if a platform hides the container's cgroup cap, set
# this to the instance's RAM in MB and the guard will measure total process
# RSS against it. Leave unset (or 0) to stay telemetry-only when no cgroup cap
# is visible.
# HERMES_MEM_LIMIT_MB=512

# Generated by the Blueprint at first deploy (generateValue: true). Reuse
# this value as API_SERVER_KEY in Render's Environment tab if you opt into
# the OpenAI-compatible API server.
HERMES_GATEWAY_TOKEN=

# Bearer token for the pre-registered Render MCP server. Get one at
# https://dashboard.render.com/u/*/settings#api-keys
#
# The MCP server's Authorization header is lazy-substituted from this
# var at gateway startup. Rotate from Render's Environment tab + restart;
# no rebuild needed.
#
# Named RENDER_MCP_API_KEY rather than the stock RENDER_API_KEY to avoid
# accidental auto-auth if someone later installs the `render` CLI. This
# is the same kind of Render API key; the Render account role behind the
# key determines what the agent can do.
RENDER_MCP_API_KEY=

# Private age key for the repo's encrypted secrets (env/secrets.enc.env).
# Generate with `./run-local.sh secrets init`; paste the AGE-SECRET-KEY-...
# line here or into Render's Environment tab. With this set, the committed
# secrets are decrypted at boot and fill in anything not already defined by
# the process environment or /opt/data/.env.
SOPS_AGE_KEY=

# Optional Bynara OpenAI-compatible router. When set, the boot patcher adds
# custom:bynara and selects qwen-3.8-max-free on a fresh/default config.
BYNARA_API_KEY=

# Optional Telegram gateway. Keep both values in Render's Environment tab on
# Free so they survive a spin-down.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ---------------------------------------------------------------------------
# State backup: a private GitHub repository
# ---------------------------------------------------------------------------
# Render Free has no persistent disk, so /opt/data has to live somewhere else.
# Git sends only the bytes that changed -- usually a few KB per save -- which
# keeps the backup inside even a small monthly transfer allowance.
#
# owner/name of a PRIVATE repo that holds nothing else, e.g. you/hermes-storage.
GIT_STATE_REPO=
# Fine-grained personal access token, scoped to that repository only, with
# Contents: read and write. Falls back to GITHUB_TOKEN when unset.
GIT_STATE_TOKEN=
# Branch the state lives on. It is force-pushed and squashed, so keep it
# separate from any branch you edit by hand.
GIT_STATE_BRANCH=state
# Saves are driven by change, not by the clock: the tree is fingerprinted
# every GIT_STATE_WATCH_SECONDS and pushed once it has been quiet for
# GIT_STATE_DEBOUNCE_SECONDS, so a change lands in GitHub inside about a
# minute. These used to be 5/10/20 and were slowed deliberately: every tick
# walks the whole state tree (~11 ms on a 600-file tree, measured, growing
# with the tree) and every push forks git, which on a 0.1 CPU service is CPU
# the chat in progress is paying for.
# GIT_STATE_MIN_PUSH_INTERVAL_SECONDS is the hard floor between two pushes so
# a frantic agent cannot churn commits. GIT_STATE_INTERVAL_SECONDS is only the
# safety net for changes the fingerprint might miss (a same-size rewrite
# inside one mtime tick). Set GIT_STATE_WATCH=0 for interval-only saves.
GIT_STATE_WATCH=1
GIT_STATE_WATCH_SECONDS=15
GIT_STATE_DEBOUNCE_SECONDS=20
GIT_STATE_MIN_PUSH_INTERVAL_SECONDS=60
GIT_STATE_INTERVAL_SECONDS=900
GIT_STATE_BIG_FILE_THRESHOLD_KB=1024
GIT_STATE_MAX_MEMORY_PCT=80
# Squash the branch to one commit after this many state commits, so old
# versions stop accumulating and the repo cannot grow forever. 0 disables it.
GIT_STATE_MAX_COMMITS=200
# How /opt/data/.env reaches the branch. "even the config env files": the
# default commits it verbatim, so the branch is a complete, restartable copy
# of the instance. It is only ever pushed to a repo confirmed private, but it
# does put live API keys in git history until the next squash -- use "encrypt"
# (with GIT_STATE_AGE_RECIPIENT) to seal it, or "omit" to leave it out.
# Under "encrypt", a missing recipient or missing age binary omits .env rather
# than committing it in the clear.
GIT_STATE_ENV_MODE=plaintext
# age public key (age1...), used when GIT_STATE_ENV_MODE=encrypt.
GIT_STATE_AGE_RECIPIENT=
# The backend refuses to push to a repository it cannot confirm is private.
# Only set this if you genuinely intend a public backup of your agent state.
# GIT_STATE_ALLOW_PUBLIC=0
# Where the working clone lives inside the container.
# GIT_STATE_WORKDIR=/tmp/hermes-git-state
# First launch: the state branch is empty, so the git sync daemon pushes this
# instance's tree to GitHub once the gateway is up, and the branch is the
# source of truth from then on. The daemon owns the seed rather than the boot
# wrapper because everything the wrapper does happens before the container
# binds a port, and Render fails a deploy that never opens one. Seeding refuses
# to touch a branch that already holds state -- set this to 1 only if you
# deliberately want the local copy to overwrite it.
# GIT_STATE_SEED_FORCE=0
# Push robustness. GitHub's HTTP front end answers an oversized or slow
# `git-receive-pack` with "RPC failed; HTTP 408", and a first state push is the
# biggest upload this service makes. The request is sent unchunked (git chunks
# anything above http.postBuffer), a transfer slower than
# GIT_STATE_HTTP_LOW_SPEED_LIMIT bytes/s for GIT_STATE_HTTP_LOW_SPEED_TIME
# seconds is abandoned instead of waited on, and the push is retried
# GIT_STATE_PUSH_ATTEMPTS times. No git command may run longer than
# GIT_STATE_GIT_TIMEOUT_SECONDS.
# Pack/transfer memory. pack-objects defaults to an unbounded delta window and
# one thread per core, so on a large state tree it can spike far past 512 MB
# and the OOM killer then takes the gateway as readily as the sync worker.
# These keep a push flat and single-threaded. The post buffer stays unchunked
# (GitHub 408s on a chunked receive-pack) but small -- these are the shipped
# defaults, spelled out so they cannot drift from env/common.env.
GIT_STATE_PACK_THREADS=1
GIT_STATE_PACK_WINDOW_MEMORY_MB=16
GIT_STATE_HTTP_POST_BUFFER_MB=64
# GIT_STATE_HTTP_LOW_SPEED_LIMIT=1000
# GIT_STATE_HTTP_LOW_SPEED_TIME=60
# GIT_STATE_PUSH_ATTEMPTS=3
# GIT_STATE_PUSH_RETRY_SECONDS=5
# GIT_STATE_GIT_TIMEOUT_SECONDS=600
# git mmaps any blob up to core.bigFileThreshold (512 MB by default) to hash
# and delta-compress it, so one changed file costs resident memory equal to
# its own size. On a 146 MB sessions.db, `git add -A` peaked at 152.0 MB with
# the default and 9.1 MB with this setting -- a "big" blob is streamed and
# stored undeltified instead. 16.7x, measured.
GIT_STATE_BIG_FILE_THRESHOLD_KB=1024
# Stand the backup down above this share of the container's memory cap rather
# than ever competing with the conversation in progress. 0 disables.
GIT_STATE_MAX_MEMORY_PCT=80
# Cap on the blocking state restore at boot, in seconds. Everything before the
# container binds its port has to fit inside Render's scan window, so a hung
# download costs this boot its restored state (and its remote sync) rather than
# the deploy. 0 waits for the backend however long that takes.
# HERMES_RESTORE_TIMEOUT_SECONDS=240
# A failed restore (a transient GitHub blip) is retried this many times while
# boot time allows, because one failure otherwise disarms state sync until the
# next restart.
# HERMES_RESTORE_ATTEMPTS=2

# Keep-alive (Render Free only; inert locally, where RENDER_EXTERNAL_URL is
# unset). A Free web service spins down after ~15 minutes without inbound HTTP,
# and chat platforms are outbound-only -- so without this the container sleeps
# mid-conversation and the agent stops answering. When RENDER_EXTERNAL_URL is
# present, the boot wrapper requests the dashboard's /api/status over the
# public URL on the cadence below, which counts as traffic and keeps the
# service awake. Set HERMES_KEEP_ALIVE=0 to let the service sleep instead
# (saves Free instance hours; the next message then waits out a cold start).
HERMES_KEEP_ALIVE=1
HERMES_KEEP_ALIVE_SECONDS=600
HERMES_KEEP_ALIVE_PATH=/api/plugins/hermes-chat-dashboard/health

# When the service stops, the container stays up this many seconds after the
# gateway exits so the sync daemon can land its final state push instead of
# being killed mid-flight. Keep this below the platform's stop grace period
# (Render's is 30s by default).
# HERMES_SHUTDOWN_FLUSH_SECONDS=20
# How many times the boot wrapper restarts the sync daemon process if it dies.
# HERMES_SYNC_DAEMON_RESTARTS=20

# Failover between this service and a local instance sharing the state repo
# (a private GitHub repository configured with GIT_STATE_REPO). The
# highest-priority instance with a fresh lease handles chat; the others keep
# their dashboard but have chat tokens stripped and never upload. Start the
# local one with `./run-local.sh --takeover`.
HERMES_FAILOVER=1
HERMES_INSTANCE_ID=render
HERMES_INSTANCE_PRIORITY=50
HERMES_LEASE_TTL_SECONDS=600
HERMES_LEASE_HEARTBEAT_SECONDS=120
HERMES_LEASE_POLL_SECONDS=30
HERMES_ROLE_SWITCH_MIN_SECONDS=300

# =============================================================================
# Everything else
# =============================================================================
# On Render Free, set these in the Render service's Environment tab. The
# Hermes dashboard's API Keys tab writes to ephemeral /opt/data and is not
# durable across a spin-down or redeploy. In local Docker or paid-disk
# deployments, the dashboard can be used as the persistent setup surface.
# Examples of what's available:
#
#   LLM providers (set at least one):
#     OPENROUTER_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY,
#     HF_TOKEN, GLM_API_KEY, KIMI_API_KEY, OLLAMA_API_KEY, ...
#
#   Messaging platforms:
#     TELEGRAM_BOT_TOKEN, DISCORD_BOT_TOKEN, SLACK_BOT_TOKEN + SLACK_APP_TOKEN,
#     WHATSAPP_*, EMAIL_*, SIGNAL_*, TEAMS_*, GOOGLE_CHAT_*, ...
#
#   Tool API keys:
#     BROWSERBASE_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY, TAVILY_API_KEY,
#     HONCHO_API_KEY, GITHUB_TOKEN, ...
#
#   OpenAI-compatible API server (off by default):
#     API_SERVER_ENABLED, API_SERVER_KEY, API_SERVER_HOST, API_SERVER_CORS_ORIGINS
#
# Render's Environment tab is the recommended source of truth for this Free
# Blueprint. Note the direction of precedence inside the container: upstream
# Hermes loads /opt/data/.env with override=True at every process start, so a
# value in that file BEATS the Environment tab. That is why the boot script
# keeps the deploy knobs above (HERMES_DASHBOARD_TUI, ports, thread caps,
# cache sizes) out of /opt/data/.env and removes stale copies of them -- a
# leftover HERMES_DASHBOARD_TUI=0 there is enough to hide the Chat tab no
# matter what the Environment tab says. When running Hermes locally, copy the
# desired values into this file instead.
