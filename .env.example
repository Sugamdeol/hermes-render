# Hermes Agent on Render: environment variables
#
# This Blueprint is designed for Render's Free instance type. Its filesystem
# is ephemeral: /opt/data/.env is lost when the service spins down or is
# redeployed. Put provider keys, tool keys, and chat platform tokens in the
# Render Environment tab so they survive those events. The Hermes dashboard
# API Keys tab is still useful for local Docker/paid-disk deployments, but
# values entered there are only temporary on Render Free.
#
# Full upstream env-var reference:
# https://github.com/NousResearch/hermes-agent/blob/main/.env.example

# =============================================================================
# Container boot config (set by the Blueprint, no user action needed)
# =============================================================================

# Hermes state directory. On Render Free this directory is ephemeral.
HERMES_HOME=/opt/data

# Render routes HTTP traffic to this port.
PORT=10000

# Enables the dashboard side-process inside the gateway container.
HERMES_DASHBOARD=1

# Bind the dashboard to all interfaces so Render's load balancer can reach it.
# The entrypoint passes --insecure automatically when this is non-loopback.
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000

# The full in-browser TUI creates a Node/esbuild PTY and costs RAM on Free.
# Keep it off by default; use Telegram or another configured chat channel.
HERMES_DASHBOARD_TUI=0

# Resource guardrails for small Render Free instances.
NODE_OPTIONS=--max-old-space-size=128
MALLOC_ARENA_MAX=2
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
# The Dockerfile makes the pinned gateway cache these many idle session agents
# for this many seconds before eviction.
HERMES_AGENT_CACHE_MAX_SIZE=16
HERMES_AGENT_CACHE_IDLE_TTL_SECONDS=900

# Generated by the Blueprint at first deploy (generateValue: true). Reuse
# this value as API_SERVER_KEY in Render's Environment tab if you opt into
# the OpenAI-compatible API server.
HERMES_GATEWAY_TOKEN=

# Bearer token for the pre-registered Render MCP server. Get one at
# https://dashboard.render.com/u/*/settings#api-keys
#
# The MCP server's Authorization header is lazy-substituted from this
# var at gateway startup. Rotate from Render's Environment tab + restart;
# no rebuild needed.
#
# Named RENDER_MCP_API_KEY rather than the stock RENDER_API_KEY to avoid
# accidental auto-auth if someone later installs the `render` CLI. This
# is the same kind of Render API key; the Render account role behind the
# key determines what the agent can do.
RENDER_MCP_API_KEY=

# Optional Bynara OpenAI-compatible router. When set, the boot patcher adds
# custom:bynara and selects qwen-3.8-max-free on a fresh/default config.
BYNARA_API_KEY=

# Optional Telegram gateway. Keep both values in Render's Environment tab on
# Free so they survive a spin-down.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Optional GoFile remote state backup for Render Free. The archive contains
# all regular files under /opt/data, including .env and logs, so the GoFile
# folder must be treated as sensitive. Keep the token in Render Environment.
GOFILE_API_TOKEN=
# Optional existing folder UUID. If blank, the service finds or creates a
# private "hermes-render-state" folder under the account.
GOFILE_FOLDER_ID=
GOFILE_FOLDER_NAME=hermes-render-state
GOFILE_STATE_PREFIX=hermes-state-
GOFILE_SYNC_INTERVAL_SECONDS=300
# Safety cap for compressed backups; increase only if the Free instance has
# enough memory. The default includes the complete /opt/data tree.
GOFILE_MAX_ARCHIVE_MB=100
# If GoFile reports error-notPremium after rotating its website token, set
# the current salt here. The image includes the current default.
# GOFILE_WT_SALT=

# =============================================================================
# Everything else
# =============================================================================
# On Render Free, set these in the Render service's Environment tab. The
# Hermes dashboard's API Keys tab writes to ephemeral /opt/data and is not
# durable across a spin-down or redeploy. In local Docker or paid-disk
# deployments, the dashboard can be used as the persistent setup surface.
# Examples of what's available:
#
#   LLM providers (set at least one):
#     OPENROUTER_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY,
#     HF_TOKEN, GLM_API_KEY, KIMI_API_KEY, OLLAMA_API_KEY, ...
#
#   Messaging platforms:
#     TELEGRAM_BOT_TOKEN, DISCORD_BOT_TOKEN, SLACK_BOT_TOKEN + SLACK_APP_TOKEN,
#     WHATSAPP_*, EMAIL_*, SIGNAL_*, TEAMS_*, GOOGLE_CHAT_*, ...
#
#   Tool API keys:
#     BROWSERBASE_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY, TAVILY_API_KEY,
#     HONCHO_API_KEY, GITHUB_TOKEN, ...
#
#   OpenAI-compatible API server (off by default):
#     API_SERVER_ENABLED, API_SERVER_KEY, API_SERVER_HOST, API_SERVER_CORS_ORIGINS
#
# Render env vars override values from /opt/data/.env at process start and are
# the recommended source of truth for this Free Blueprint. When running
# Hermes locally, copy the desired values into this file instead.
