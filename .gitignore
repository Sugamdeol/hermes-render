# Local env file with real secrets. Never commit.
.env
.env.local
.env.*.local

# age / SOPS private keys, and any DECRYPTED copy of the repo secrets.
# env/secrets.enc.env is the encrypted file and IS meant to be committed;
# anything that looks like its plaintext is not.
keys.txt
*.agekey
age-key.txt
env/secrets.env
env/*.plain.env
env/*.dec.env

# SSH keys, certificates, anything secret-shaped. Never commit.
*.pem
*.key
*-key
*-key.pub
*_key
*_key.pub
id_*
*.cert
*.crt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Node (in case anyone clones the upstream repo into here for local poking)
node_modules/
npm-debug.log*

# Local upstream clone used during template development.
.hermes-upstream/
