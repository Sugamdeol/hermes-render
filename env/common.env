# Non-secret defaults; secrets are configured in the native dashboard.
HERMES_HOME=/opt/data
PORT=10000
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=127.0.0.1
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_TUI=1
NODE_OPTIONS=--max-old-space-size=64
MALLOC_ARENA_MAX=2
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
HERMES_AGENT_CACHE_MAX_SIZE=2
HERMES_AGENT_CACHE_IDLE_TTL_SECONDS=120
