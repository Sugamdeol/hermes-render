# Non-secret configuration, shared by the Render service and run-local.sh.
#
# These are the same values render.yaml declares inline. Nothing here is
# sensitive; anything that is belongs in secrets.enc.env.

# Hermes state directory and the port Render routes traffic to.
HERMES_HOME=/opt/data
PORT=10000

# Dashboard side-process.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000
# The in-browser Chat tab. Upstream gates the pure-Python chat WebSocket
# (/api/ws -- JSON-RPC over tui_gateway.dispatch, which the bundled
# hermes-chat-dashboard plugin drives) behind this same flag as the
# terminal-PTY fallback (/api/pty). With it off the Chat tab does not
# render and its WebSocket answers 4403; with it on the chat works.
# The heavy Node/esbuild PTY process is only ever spawned when a client
# actually connects to /api/pty -- the plugin never does -- so leaving
# this on does not add a Node process to idle RAM.
HERMES_DASHBOARD_TUI=1
# Per dashboard chat session, tui_gateway spawns a persistent slash-command
# helper as a *second* full Python interpreter (cli.HermesCLI), i.e. tens of
# MB of resident RAM per open conversation. The chat UI does not expose the
# slash menu, so disable the worker entirely on this small instance. The
# dashboard process still answers every normal chat/tool request.
HERMES_TUI_DISABLE_SLASH_WORKER=1
# tui_gateway hands long RPC handlers to a thread pool; four resident threads
# is a workstation default. Two is plenty for one dashboard user and keeps
# concurrent handler stacks off the small instance.
HERMES_TUI_RPC_POOL_WORKERS=2
# A dashboard chat session is a full AIAgent kept in the dashboard process,
# and upstream only detaches it when the browser tab's WebSocket drops.
# Finalize (and pop) sessions owned by a closing socket instead: the
# transcript stays in the session DB and re-opens with session.resume.
HERMES_TUI_CLOSE_SESSIONS_ON_DISCONNECT=1

# Resource guardrails for small Free instances.
# NODE_OPTIONS applies to the occasional Node child (dashboard PTY, esbuild
# TUI builds): cap its V8 old-space so a TUI build cannot exhaust RAM before
# the OS reclaims it. Normal chat never starts Node at all.
NODE_OPTIONS=--max-old-space-size=96
MALLOC_ARENA_MAX=2
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
# Don't let pip/packaging subprocesses run parallel builds either.
MAKEFLAGS=-j1
# Bound the pinned gateway's cached per-session agent objects. These
# values are read by the small Dockerfile source patch at process import.
HERMES_AGENT_CACHE_MAX_SIZE=8
HERMES_AGENT_CACHE_IDLE_TTL_SECONDS=600
# Git state-sync memory: git eagerly mallocs http.postBuffer on every push
# and pack-objects defaults to unbounded delta windows / one thread per
# core, so the shipped defaults can spike a push far past 512 MB (and the
# OOM killer then takes the gateway as readily as the sync worker). Keep
# the request unchunked (GitHub 408s on chunked receive-packs) but small,
# and cap pack memory. State trees here are a few tens of MB at most.
GIT_STATE_HTTP_POST_BUFFER_MB=64
GIT_STATE_PACK_WINDOW_MEMORY_MB=16
GIT_STATE_PACK_THREADS=1
