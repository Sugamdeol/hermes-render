# Non-secret configuration, shared by the Render service and run-local.sh.
#
# These are the same values render.yaml declares inline. Nothing here is
# sensitive; anything that is belongs in secrets.enc.env.

# Hermes state directory and the port Render routes traffic to.
HERMES_HOME=/opt/data
PORT=10000

# Dashboard side-process.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000
HERMES_DASHBOARD_TUI=0

# Resource guardrails for small Free instances.
NODE_OPTIONS=--max-old-space-size=128
MALLOC_ARENA_MAX=2
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
HERMES_AGENT_CACHE_MAX_SIZE=16
HERMES_AGENT_CACHE_IDLE_TTL_SECONDS=900

# GoFile state backup defaults. Inert until GOFILE_API_TOKEN is set.
GOFILE_FOLDER_NAME=hermes-render-state
GOFILE_STATE_PREFIX=hermes-state-
GOFILE_SYNC_INTERVAL_SECONDS=300
GOFILE_MAX_ARCHIVE_MB=100
