# Non-secret configuration, shared by the Render service and run-local.sh.
#
# These are the same values render.yaml declares inline. Nothing here is
# sensitive; anything that is belongs in secrets.enc.env.

# Hermes state directory and the port Render routes traffic to.
HERMES_HOME=/opt/data
PORT=10000

# Dashboard side-process.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=10000
# The in-browser Chat tab. Upstream gates the pure-Python chat WebSocket
# (/api/ws -- JSON-RPC over tui_gateway.dispatch, which the bundled
# hermes-chat-dashboard plugin drives) behind this same flag as the
# terminal-PTY fallback (/api/pty). With it off the Chat tab does not
# render and its WebSocket answers 4403; with it on the chat works.
# The heavy Node/esbuild PTY process is only ever spawned when a client
# actually connects to /api/pty -- the plugin never does -- so leaving
# this on does not add a Node process to idle RAM.
HERMES_DASHBOARD_TUI=1
# Per dashboard chat session, tui_gateway spawns a persistent slash-command
# helper as a *second* full Python interpreter (cli.HermesCLI), i.e. tens of
# MB of resident RAM per open conversation. The chat UI does not expose the
# slash menu, so disable the worker entirely on this small instance. The
# dashboard process still answers every normal chat/tool request.
HERMES_TUI_DISABLE_SLASH_WORKER=1
# tui_gateway hands long RPC handlers to a thread pool; four resident threads
# is a workstation default. Two is plenty for one dashboard user and keeps
# concurrent handler stacks off the small instance.
HERMES_TUI_RPC_POOL_WORKERS=2
# A dashboard chat session is a full AIAgent kept in the dashboard process,
# and upstream only detaches it when the browser tab's WebSocket drops.
# Finalize (and pop) sessions owned by a closing socket instead: the
# transcript stays in the session DB and re-opens with session.resume.
HERMES_TUI_CLOSE_SESSIONS_ON_DISCONNECT=1
# Hard cap on live in-process chat sessions (Dockerfile-patched
# tui_gateway registry). Nothing upstream bounds the registry, so a browser
# tab that vanishes without a clean close pins its agent in the dashboard for
# the life of the container and the growth is linear in how many there are
# (measured over 24 abandoned tabs: 0.20 MB per conversation capped vs 0.97 MB
# uncapped, and only the capped curve plateaus). Over the cap the oldest are
# finalized and dropped -- transcript first, so they re-open via
# session.resume -- and a session mid-turn is skipped. 0 disables.
HERMES_TUI_MAX_SESSIONS=2

# Resource guardrails for small Free instances.
# NODE_OPTIONS applies to the occasional Node child (dashboard PTY, esbuild
# TUI builds): cap its V8 old-space so a TUI build cannot exhaust RAM before
# the OS reclaims it. Normal chat never starts Node at all.
NODE_OPTIONS=--max-old-space-size=96
MALLOC_ARENA_MAX=2
# glibc's malloc grows its trim threshold dynamically (up to 32 MB) when it
# sees heavy freeing, which means freed pages are held rather than returned to
# the OS -- invisible to Python's gc and fatal under a 512 MB ceiling. Pinning
# it keeps the allocator handing pages back. Verified in tools/bench, not
# assumed.
MALLOC_TRIM_THRESHOLD_=131072
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1
NUMEXPR_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
# Don't let pip/packaging subprocesses run parallel builds either.
MAKEFLAGS=-j1
# Bound the pinned gateway's cached per-session agent objects. These
# values are read by the small Dockerfile source patch at process import.
HERMES_AGENT_CACHE_MAX_SIZE=2
HERMES_AGENT_CACHE_IDLE_TTL_SECONDS=120
# Git state-sync memory: git eagerly mallocs http.postBuffer on every push
# and pack-objects defaults to unbounded delta windows / one thread per
# core, so the shipped defaults can spike a push far past 512 MB (and the
# OOM killer then takes the gateway as readily as the sync worker). Keep
# the request unchunked (GitHub 408s on chunked receive-packs) but small,
# and cap pack memory. State trees here are a few tens of MB at most.
GIT_STATE_HTTP_POST_BUFFER_MB=64
GIT_STATE_PACK_WINDOW_MEMORY_MB=16
GIT_STATE_PACK_THREADS=1
# Every watch tick walks the whole state tree to fingerprint it (~11 ms on a
# 600-file tree, measured, and it grows with the tree) and every push forks
# git, so on 0.1 CPU this cadence competes directly with the chat being paid
# for. 15s/20s/60s still lands a change in GitHub inside about a minute.
GIT_STATE_WATCH_SECONDS=15
GIT_STATE_DEBOUNCE_SECONDS=20
GIT_STATE_MIN_PUSH_INTERVAL_SECONDS=60
# Safety net for a change the fingerprint misses; the watcher does the real
# work, so 15 minutes is plenty.
GIT_STATE_INTERVAL_SECONDS=900
# git mmaps any blob up to core.bigFileThreshold (512 MB by default) to hash
# and delta-compress it, so one changed file costs resident memory equal to
# its own size. On a 146 MB sessions.db, `git add -A` peaked at 152.0 MB with
# the default and 9.1 MB with this -- a "big" blob is streamed and stored
# undeltified instead. 16.7x, and the difference between the sync fitting in
# the leftover budget and it eating a third of the container.
GIT_STATE_BIG_FILE_THRESHOLD_KB=1024
# A push is the only routine operation here that allocates in a hurry, so the
# backup stands itself down above this share of the container's memory cap
# rather than ever competing with the conversation in progress. 0 disables.
GIT_STATE_MAX_MEMORY_PCT=80
# Staged degradation (bootstrap.sh). HIGH pauses the sync daemon and reaps
# orphaned slash workers; CRITICAL stops it for good and holds its supervisor
# off; EMERGENCY recycles the dashboard (SIGTERM so sessions finalize, then
# SIGKILL) and never the gateway. Any stage set to 0 is off.
HERMES_MEMGUARD=1
HERMES_MEMGUARD_INTERVAL_SECONDS=3
HERMES_MEMGUARD_WARN=70
HERMES_MEMGUARD_PAUSE_SYNC=80
HERMES_MEMGUARD_RESUME_SYNC=62
HERMES_MEMGUARD_CRITICAL=87
HERMES_MEMGUARD_DASHBOARD_PCT=92
# A guard that cannot measure the container would guess from the host. When the
# cgroup cap is hidden (a container runtime that does not expose it) usage is
# estimated from the sum of process RSS instead, and that is only safe if this
# matches the real limit -- so it stays pinned to the Render Free size.
HERMES_MEMGUARD_MAX_ACTIVE_MB=512
# The keep-alive is a single curl against this process every 10 minutes. It
# exists only to stop Render idling the Free instance; anything more frequent
# is background load the chat would pay for.
HERMES_KEEP_ALIVE_SECONDS=600
HERMES_KEEP_ALIVE_PATH=/api/plugins/hermes-chat-dashboard/health
# What the keep-alive loop requests. The cheap plugin /health, not /api/status
# -- the latter re-parses config.yaml, loads the gateway config and opens
# SQLite to count sessions, 180-700 ms of this container's CPU per call, to
# answer a question whose only real content is "still here".
HERMES_KEEP_ALIVE_PATH=/api/plugins/hermes-chat-dashboard/health
